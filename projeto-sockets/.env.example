# Publicação no host. Mantenha o loopback em ambientes de desenvolvimento.
BIND_ADDRESS=127.0.0.1

# Observabilidade
LOG_LEVEL=INFO

# Quantidade de dispositivos virtuais por processo
C_DEVICE_COUNT=6
LUA_DEVICE_COUNT=3
JAVA_DEVICE_COUNT=3
CAMERA_DEVICE_COUNT=3
GO_PARKING_DEVICE_COUNT=3

# Validade dos comandos dos sensores Lua, Java e Python
CONTROL_COMMAND_MAX_AGE_SECS=300
CONTROL_COMMAND_MAX_FUTURE_SKEW_SECS=30

# Presença e descoberta
SENSOR_HEARTBEAT_INTERVAL_SECS=10
SENSOR_HEARTBEAT_JITTER_SECS=2
SENSOR_DISCOVERY_JITTER_SECS=2
DISCOVERY_PROBE_INTERVAL_SECS=15
DEVICE_OFFLINE_TIMEOUT_SECS=45

# Prazo de drenagem no encerramento; mantenha abaixo de stop_grace_period.
TELEMETRY_SHUTDOWN_TIMEOUT_SECS=20

# Limites das consultas analíticas
OLAP_MAX_QUERY_WINDOW_SECS=2592000
OLAP_MAX_GRAPH_POINTS=2000

# Limites da fronteira de rede do gateway
TCP_MAX_FRAME_BYTES=1048576
UDP_MAX_DATAGRAM_BYTES=16384
MAX_DEVICE_ID_LENGTH=128
MAX_MESSAGE_ID_LENGTH=128
MAX_METRIC_NAME_LENGTH=128
MAX_METRIC_UNIT_LENGTH=32
MAX_METRICS_PER_PAYLOAD=64
MESSAGE_MAX_AGE_SECS=86400
MESSAGE_MAX_FUTURE_SKEW_SECS=300

# Consulte ../docs/operations.md para retenção, filas, rollups e demais opções.
